# MySQL root 仅由初始化容器使用；Application 服务使用 claim_app 账号。
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
# Redis ACL 账号；修改后同步设置 CLAIM_APPLICATION_REDIS_USERNAME/PASSWORD。
REDIS_USERNAME=claim_app
REDIS_PASSWORD=claim_redis
REDIS_PORT=6379
# RocketMQ 对宿主机暴露的端口；Broker 地址仅在宿主机网卡特殊时覆盖。
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_FAST_PORT=10909
ROCKETMQ_BROKER_IP1=127.0.0.1
# Dashboard 仅供本地检查 NameServer、Broker、Topic 与消费者状态。
# 宿主机端口固定避开 8082（claim-case-service 使用该端口）。
ROCKETMQ_DASHBOARD_PORT=8090
ROCKETMQ_DASHBOARD_USERNAME=claim_admin
ROCKETMQ_DASHBOARD_PASSWORD=claim_dashboard
