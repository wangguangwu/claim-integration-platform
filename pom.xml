<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.wangguangwu.claim</groupId>
    <artifactId>claim-integration-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>claim-integration-platform</name>
    <description>理赔业务集成平台</description>

    <modules>
        <module>backend/claim-bom</module>
        <module>backend/claim-foundation</module>
        <module>backend/claim-gateway</module>
        <module>backend/claim-application-service</module>
        <module>backend/claim-case-service</module>
        <module>backend/claim-ai-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <claim-bom.version>1.0.0-SNAPSHOT</claim-bom.version>
        <claim-foundation.version>${project.version}</claim-foundation.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.wangguangwu.claim</groupId>
                <artifactId>claim-bom</artifactId>
                <version>${claim-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.wangguangwu.claim</groupId>
                <artifactId>claim-foundation-common</artifactId>
                <version>${claim-foundation.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wangguangwu.claim</groupId>
                <artifactId>claim-foundation-tenant</artifactId>
                <version>${claim-foundation.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wangguangwu.claim</groupId>
                <artifactId>claim-foundation-observability</artifactId>
                <version>${claim-foundation.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 服务模块有了启动类后再显式引入本插件，产出可执行包 -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
